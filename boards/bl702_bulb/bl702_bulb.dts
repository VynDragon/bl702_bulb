/dts-v1/;

#include <bflb/bl702.dtsi>
#include "bl702_bulb-pinctrl.dtsi"

/ {
	model = "BL702 Bulb";
	compatible = "bflb,bl702";

	chosen {
		zephyr,flash = &kh25v80;
		zephyr,flash-controller = &sf_bank1;
		zephyr,code-partition = &slot0_partition;
		zephyr,itcm = &itcm;
		zephyr,sram = &sram0_bt;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ot-uart = &uart0;
		zephyr,entropy = &sec_eng_trng;
		zephyr,ieee802154 = &ieee802154;
		zephyr,bt-hci = &bt_hci_bflb;
	};

	aliases {
		watchdog0 = &wdt0;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &green_pwm_led;
		pwm-led2 = &blue_pwm_led;
		pwm-led3 = &warm_white_pwm_led;
		pwm-led4 = &cold_white_pwm_led;
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "okay";

		red_pwm_led: led_pwm_0 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Red - LED0 PWM";
		};

		green_pwm_led: led_pwm_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Green - LED1 PWM";
		};

		blue_pwm_led: led_pwm_2 {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Blue - LED2 PWM";
		};

		warm_white_pwm_led: led_pwm_3 {
			pwms = <&pwm0 3 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Warm White - LED3 PWM";
		};

		cold_white_pwm_led: led_pwm_4 {
			pwms = <&pwm0 4 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Cold White - LED4 PWM";
		};
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(144)>;
};

&sf_bank1 {
	reg = <0x23000000 0x100000>;
	ranges = <0x0 0x23000000 0x100000>;

	kh25v80: flash@0 {
		compatible = "bflb,sf-flash", "soc-nv-flash";
		reg = <0 0x100000>;
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;
		write-block-size = <4>;
		erase-block-size = <DT_SIZE_K(4)>;

		/* Sad flash can only do DO at best */
		spi-bus-mode = <1>;
		sf-pad = <2>;
		jedec-id = [c2 20 14];

		partitions {
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			boot_header_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "boot_header";
				reg = <0x00000000 0x2000>;
				read-only;
			};

			slot0_partition: partition@2000 {
				compatible = "zephyr,mapped-partition";
				label = "image-0";
				reg = <0x00002000 (0xf0000 - 0x2000)>;
				read-only;
			};

			storage_partition: partition@f0000 {
				compatible = "zephyr,mapped-partition";
				label = "storage";
				reg = <0x00f0000 0x10000>;
			};
		};
	};
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&pwm0 {
	status = "okay";

	pinctrl-0 = <&pwm0_default>;
	pinctrl-names = "default";
};

&wdt0 {
	status = "okay";
};

&sec_eng_trng {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&bt_hci_bflb {
	status = "okay";
};
